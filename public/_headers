/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' https://ce.judge0.com https://ide.ankb.qzz.io; worker-src 'self' blob:; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/app/*
  Cache-Control: public, max-age=31536000, immutable

/logo.png
  Cache-Control: public, max-age=86400

/logo.jpg
  Cache-Control: public, max-age=86400

/api/*
  Access-Control-Allow-Origin: *
  Cache-Control: no-store
