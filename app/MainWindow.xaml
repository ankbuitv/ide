<Window x:Class="IdeAnkb.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ide.ankb — C++ Online IDE Desktop (Local g++)" Height="900" Width="1400"
        Background="#0d1117" Foreground="#c9d1d9"
        WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/logo.ico"
        Closing="Window_Closing"
        Loaded="Window_Loaded"
        WindowStyle="SingleBorderWindow"
        ResizeMode="CanResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="28"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="22"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="48"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Row="0" Grid.RowSpan="4" Background="#0d1117" BorderBrush="#30363d" BorderThickness="0,0,1,0">
            <StackPanel Margin="0,8,0,0">
                <Button Content="📁" ToolTip="Explorer" Background="#161b22" Foreground="#58a6ff" FontSize="16" Margin="4" Height="36"/>
                <Button Content="🔍" ToolTip="Search" Background="Transparent" Foreground="#8b949e" FontSize="16" Margin="4" Height="36"/>
                <Button Content="🌿" ToolTip="Source Control" Background="Transparent" Foreground="#8b949e" FontSize="16" Margin="4" Height="36"/>
                <Button Content="▶️" ToolTip="Run" Background="Transparent" Foreground="#8b949e" FontSize="16" Margin="4" Height="36"/>
                <Button Content="🧩" ToolTip="Extensions" Background="Transparent" Foreground="#8b949e" FontSize="16" Margin="4" Height="36"/>
                <StackPanel VerticalAlignment="Bottom" Margin="0,20,0,0">
                    <Button Content="📂" ToolTip="Open File" Click="OpenFile_Click" Background="Transparent" Foreground="#8b949e" FontSize="16" Margin="4" Height="36"/>
                    <Button Content="💾" ToolTip="Download" Click="Download_Click" Background="Transparent" Foreground="#8b949e" FontSize="16" Margin="4" Height="36"/>
                    <Button Content="⚙️" ToolTip="Settings" Background="Transparent" Foreground="#8b949e" FontSize="16" Margin="4" Height="36"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- TopBar -->
        <Border Grid.Row="0" Grid.Column="1" Background="#161b22" BorderBrush="#30363d" BorderThickness="0,0,0,1" MouseLeftButtonDown="TopBar_MouseDown">
            <DockPanel Margin="12,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/logo.png" Width="28" Height="28" Margin="0,0,10,0"/>
                    <TextBlock Text="ide.ankb" FontWeight="Bold" FontFamily="Consolas" FontSize="14" VerticalAlignment="Center">
                        <TextBlock.Foreground>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                <GradientStop Color="#58a6ff" Offset="0"/>
                                <GradientStop Color="#a371f7" Offset="1"/>
                            </LinearGradientBrush>
                        </TextBlock.Foreground>
                    </TextBlock>
                    <TextBlock Text="workspace/main.cpp" Margin="16,0,0,0" Foreground="#8b949e" FontFamily="Consolas" FontSize="12" VerticalAlignment="Center"/>
                    <ComboBox x:Name="CppVersionCombo" Margin="16,0,0,0" Width="90" SelectedIndex="0" Background="#1c2128" Foreground="#c9d1d9" BorderBrush="#30363d" FontSize="11">
                        <ComboBoxItem Content="C++23" Tag="23" IsSelected="True"/>
                        <ComboBoxItem Content="C++20" Tag="20"/>
                        <ComboBoxItem Content="C++17" Tag="17"/>
                        <ComboBoxItem Content="C++14" Tag="14"/>
                        <ComboBoxItem Content="C++11" Tag="11"/>
                    </ComboBox>
                    <Border x:Name="ConnBadge" Margin="12,0,0,0" Padding="6,3" CornerRadius="12" Background="#161b22" BorderBrush="#3fb950" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ConnDot" Width="8" Height="8" Fill="#3fb950" Margin="0,0,6,0"/>
                            <TextBlock x:Name="ConnLabel" Text="🟢 Online (Judge0)" FontSize="11" FontWeight="Bold" Foreground="#3fb950"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="📂 Open" Click="OpenFile_Click" Background="#21262d" Foreground="#c9d1d9" BorderBrush="#30363d" Padding="8,4" Margin="4,0" FontSize="11"/>
                    <Button Content="💾 Save" Click="Download_Click" Background="#21262d" Foreground="#c9d1d9" BorderBrush="#30363d" Padding="8,4" Margin="4,0" FontSize="11"/>
                    <Button Content="♻ Reset" Click="Reset_Click" Background="Transparent" Foreground="#8b949e" BorderBrush="Transparent" Padding="8,4" Margin="4,0" FontSize="11"/>
                    <Button x:Name="RunButton" Content="▶ Run (F5)" Click="Run_Click" Background="#238636" Foreground="White" BorderBrush="#2ea043" Padding="12,6" Margin="8,0,0,0" FontWeight="Bold" FontSize="12"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- TabBar -->
        <Border Grid.Row="1" Grid.Column="1" Background="#161b22" BorderBrush="#30363d" BorderThickness="0,0,0,1">
            <DockPanel Margin="8,0">
                <StackPanel Orientation="Horizontal">
                    <Border Background="#1c2128" BorderBrush="#30363d" BorderThickness="1,1,1,0" CornerRadius="6,6,0,0" Padding="8,2" Margin="0,0,4,0">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#f34b7d" Margin="0,0,6,0"/>
                            <TextBlock x:Name="TabFileName" Text="main.cpp" FontFamily="Consolas" FontSize="12"/>
                            <TextBlock Text="×" Margin="8,0,0,0" Foreground="#6e7681" Cursor="Hand" MouseDown="CloseTab_Click"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Background="#21262d" BorderBrush="#30363d" BorderThickness="1" CornerRadius="4" Padding="4,6" Margin="0,0,8,0">
                        <TextBlock x:Name="LangChip" Text="C++23" FontSize="10" Foreground="#8b949e"/>
                    </Border>
                    <TextBlock x:Name="AutoSaveChip" Text="Auto Save ✓" FontSize="10" Foreground="#6e7681" VerticalAlignment="Center"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Workarea -->
        <Grid Grid.Row="2" Grid.Column="1" Background="#0d1117">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="420"/>
            </Grid.ColumnDefinitions>

            <!-- Editor -->
            <Border Grid.Column="0" Background="#0d1117">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="120"/>
                    </Grid.RowDefinitions>
                    <TextBox x:Name="EditorBox" Grid.Row="0" Background="#0d1117" Foreground="#c9d1d9" 
                             FontFamily="Consolas" FontSize="13" 
                             AcceptsReturn="True" AcceptsTab="True" 
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             TextWrapping="NoWrap" Padding="12"
                             BorderThickness="0"/>
                    <Border Grid.Row="1" Background="#161b22" BorderBrush="#30363d" BorderThickness="0,1,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="24"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Background="#1c2128" BorderBrush="#30363d" BorderThickness="0,0,0,1" Padding="8,2">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Input (stdin)" FontSize="10" FontWeight="Bold" Foreground="#8b949e" VerticalAlignment="Center"/>
                                    <Button Content="Clear" Click="ClearStdin_Click" Background="Transparent" Foreground="#6e7681" BorderThickness="0" FontSize="10" Margin="8,0,0,0" Padding="4,1"/>
                                </StackPanel>
                            </Border>
                            <TextBox x:Name="StdinBox" Grid.Row="1" Background="#0d1117" Foreground="#c9d1d9" FontFamily="Consolas" FontSize="12" 
                                     AcceptsReturn="True" Padding="8" BorderThickness="0" VerticalScrollBarVisibility="Auto"
                                     TextWrapping="Wrap" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Width="8" Background="Transparent" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Cursor="SizeWE"/>

            <!-- Output -->
            <Border Grid.Column="2" Background="#161b22" BorderBrush="#30363d" BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="28"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="24"/>
                    </Grid.RowDefinitions>
                    <Border Background="#1c2128" BorderBrush="#30363d" BorderThickness="0,0,0,1" Padding="8,0">
                        <DockPanel>
                            <TextBlock Text="Output" FontSize="10" FontWeight="Bold" Foreground="#c9d1d9" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock x:Name="TimeChip" Text="— ms" FontSize="10" Background="#21262d" Foreground="#8b949e" Padding="4,2" Margin="0,0,6,0"/>
                                <Button Content="Clear" Click="ClearOutput_Click" Background="Transparent" Foreground="#6e7681" FontSize="10" BorderThickness="0" Padding="4,2"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Background="#0d1117">
                        <TextBox x:Name="OutputBox" Background="#0d1117" Foreground="#c9d1d9" FontFamily="Consolas" FontSize="12"
                                 IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                 BorderThickness="0" Padding="10"
                                 Text="// Run your code to see output here"/>
                    </ScrollViewer>
                    <Border Grid.Row="2" Background="#161b22" BorderBrush="#30363d" BorderThickness="0,1,0,0" Padding="6,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="StatusBackend" Text="Mode: Judge0 CE" FontSize="10" Foreground="#58a6ff" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StatusMsg" Text="Ready" FontSize="10" Foreground="#8b949e" Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- StatusBar -->
        <Border Grid.Row="3" Grid.Column="1" Background="#161b22" BorderBrush="#30363d" BorderThickness="0,1,0,0">
            <DockPanel Margin="8,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="C++" Foreground="#58a6ff" FontSize="11" FontWeight="Bold" Margin="0,0,12,0"/>
                    <TextBlock x:Name="StatusCursor" Text="Ln 1, Col 1" FontSize="11" Foreground="#8b949e" Margin="0,0,12,0"/>
                    <TextBlock Text="UTF-8" FontSize="11" Foreground="#8b949e" Margin="0,0,12,0"/>
                    <TextBlock Text="Spaces: 4" FontSize="11" Foreground="#8b949e"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusTime" Text="— ms" FontSize="11" Foreground="#8b949e" Margin="0,0,12,0"/>
                    <TextBlock Text="ide.ankb" FontSize="11" Foreground="#6e7681"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
