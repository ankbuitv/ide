<Window x:Class="IdeAnkb.WebView2.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="ide.ankb — C++ Online IDE Desktop (WebView2 + Local g++)" Height="900" Width="1400"
        Background="#0d1117" Foreground="#c9d1d9"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Icon="pack://application:,,,/logo.ico"
        Closing="Window_Closing"
        Loaded="Window_Loaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="24"/>
        </Grid.RowDefinitions>

        <!-- Top bar with offline compiler toggle -->
        <Border Grid.Row="0" Background="#161b22" BorderBrush="#30363d" BorderThickness="0,0,0,1">
            <DockPanel Margin="8,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/logo.png" Width="24" Height="24" Margin="0,0,8,0"/>
                    <TextBlock Text="ide.ankb" FontWeight="Bold" FontFamily="Consolas" FontSize="13" VerticalAlignment="Center" Foreground="#58a6ff"/>
                    <TextBlock Text="WebView2" Margin="10,0,0,0" FontSize="10" Foreground="#8b949e" VerticalAlignment="Center" Background="#1c2128" Padding="4,2"/>
                    <ComboBox x:Name="CompilerSelector" Margin="12,0,0,0" Width="160" SelectedIndex="0" FontSize="11" Background="#1c2128" Foreground="#c9d1d9">
                        <ComboBoxItem Content="🌐 Judge0 CE (online)" Tag="judge0" IsSelected="True"/>
                        <ComboBoxItem Content="💻 Local g++ (offline)" Tag="local"/>
                        <ComboBoxItem Content="🔀 Auto (local→Judge0)" Tag="auto"/>
                    </ComboBox>
                    <TextBlock x:Name="GccStatus" Text="Checking g++..." FontSize="10" Foreground="#8b949e" Margin="8,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="📂 Open" Click="OpenFile_Click" Padding="6,3" Margin="2" FontSize="11" Background="#21262d" Foreground="#c9d1d9"/>
                    <Button Content="💾 Save" Click="SaveFile_Click" Padding="6,3" Margin="2" FontSize="11" Background="#21262d" Foreground="#c9d1d9"/>
                    <Button Content="🧪 Test Cases" Click="TestCases_Click" Padding="6,3" Margin="2" FontSize="11" Background="#21262d" Foreground="#c9d1d9"/>
                    <Button Content="⚙ Settings" Click="Settings_Click" Padding="6,3" Margin="2" FontSize="11" Background="Transparent" Foreground="#8b949e"/>
                    <Button Content="🔄 Reload" Click="Reload_Click" Padding="6,3" Margin="8,0,0,0" FontSize="11" Background="#1c2128" Foreground="#8b949e"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- WebView2 hosting the web IDE -->
        <Grid Grid.Row="1" Background="#0d1117">
            <wv2:WebView2 x:Name="WebView" />
            <StackPanel x:Name="LoadingOverlay" VerticalAlignment="Center" HorizontalAlignment="Center" Background="#161b22" >
                <TextBlock Text="ide.ankb" FontSize="24" FontWeight="Bold" Foreground="#58a6ff" HorizontalAlignment="Center"/>
                <TextBlock Text="Loading WebView2..." Foreground="#8b949e" Margin="0,8,0,0" HorizontalAlignment="Center"/>
                <ProgressBar IsIndeterminate="True" Width="200" Height="4" Margin="0,12,0,0"/>
            </StackPanel>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="#161b22" BorderBrush="#30363d" BorderThickness="0,1,0,0" Padding="8,0">
            <DockPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="C++" Foreground="#58a6ff" FontSize="11" FontWeight="Bold" Margin="0,0,10,0"/>
                    <TextBlock x:Name="StatusCursor" Text="Ready" FontSize="11" Foreground="#8b949e" Margin="0,0,10,0"/>
                    <TextBlock x:Name="StatusBackend" Text="Mode: WebView2 + Local g++" FontSize="11" Foreground="#8b949e"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Discord RPC" FontSize="10" Foreground="#6e7681" Margin="0,0,6,0" VerticalAlignment="Center"/>
                    <Ellipse x:Name="DiscordDot" Width="6" Height="6" Fill="#6e7681" Margin="0,0,10,0"/>
                    <TextBlock x:Name="StatusTime" Text="— ms" FontSize="11" Foreground="#8b949e"/>
                </StackPanel>
            </DockPanel>
        </Border>
    </Grid>
</Window>
